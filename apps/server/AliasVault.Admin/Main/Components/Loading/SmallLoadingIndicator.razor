<div role="status" class="px-2" title="@Title">
    <UiIcon Icon="UiIcons.SpinnerFlowbite" class="@($"inline w-7 h-7 text-gray-200 {(Spinning ? "animate-spin fill-primary-600" : string.Empty)} dark:text-gray-600")" />
    <span class="sr-only">Loading...</span>
</div>

@code {
    /// <summary>
    /// Optional title of the loading indicator.
    /// </summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Set spinning to false to stop the animation.
    /// </summary>
    [Parameter]
    public bool Spinning { get; set; } = true;

}
