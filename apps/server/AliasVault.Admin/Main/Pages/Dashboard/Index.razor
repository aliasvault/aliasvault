@page "/"
@using AliasVault.Admin.Main.Pages.Dashboard.Components
@inherits MainBase

<LayoutPageTitle>Home</LayoutPageTitle>

@if (ShowTwoFactorWarning)
{
    <div class="grid px-4 pt-6 -mb-2 dark:bg-gray-900 [&>:last-child]:mb-0">
        <AlertMessageWarning Message="Two-factor authentication is not enabled for this admin account. It is recommended to enable it in Account Settings for better security." OnDismiss="DismissTwoFactorWarning" />
    </div>
}

<PageHeader
    BreadcrumbItems="@BreadcrumbItems"
    Title="AliasVault Admin"
    Description="Welcome to the AliasVault admin dashboard. Below you can find the most recent activity, status and statistics for this server.">
    <CustomActions>
        <RefreshButton OnClick="RefreshData" ButtonText="Refresh" />
        <a href="all-time-stats" class="@($"inline-flex {ButtonStyles.BaseClasses} {ButtonStyles.GetColorClasses("light")}")">
            <UiIcon Icon="UiIcons.ChartBar" class="w-4 h-4" />
            <span class="inline ml-2">All-Time Stats</span>
        </a>
    </CustomActions>
</PageHeader>

<div class="px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <RecentActiveUsersCard @ref="_recentActiveUsersCard" />
        <ServiceStatusCard @ref="_serviceStatusCard" />
        <ActiveUsersCard @ref="_activeUsersCard" />
        <RegistrationStatisticsCard @ref="_registrationStatisticsCard" />
        <EmailStatisticsCard @ref="_emailStatisticsCard" />
        <EmailClaimsCard @ref="_emailClaimsCard" />
    </div>
</div>

@code {
    /// <summary>
    /// The sessionStorage key that hides the 2FA warning until the browser tab is closed.
    /// </summary>
    private const string TwoFactorWarningDismissedKey = "twoFactorWarningDismissed";

    private bool ShowTwoFactorWarning { get; set; }

    private ServiceStatusCard? _serviceStatusCard;
    private RecentActiveUsersCard? _recentActiveUsersCard;
    private ActiveUsersCard? _activeUsersCard;
    private RegistrationStatisticsCard? _registrationStatisticsCard;
    private EmailStatisticsCard? _emailStatisticsCard;
    private EmailClaimsCard? _emailClaimsCard;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            if (!UserService.User().TwoFactorEnabled)
            {
                ShowTwoFactorWarning = await Js.InvokeAsync<string?>("sessionStorage.getItem", TwoFactorWarningDismissedKey) != "true";
                StateHasChanged();
            }

            await RefreshData();
        }
    }

    /// <summary>
    /// Hides the 2FA warning until this browser tab is closed.
    /// </summary>
    private async Task DismissTwoFactorWarning()
    {
        ShowTwoFactorWarning = false;
        await Js.InvokeVoidAsync("sessionStorage.setItem", TwoFactorWarningDismissedKey, "true");
    }

    /// <summary>
    /// Refreshes the data displayed on the cards.
    /// </summary>
    private async Task RefreshData()
    {
        if (_serviceStatusCard != null &&
            _recentActiveUsersCard != null &&
            _activeUsersCard != null &&
            _registrationStatisticsCard != null &&
            _emailStatisticsCard != null &&
            _emailClaimsCard != null)
        {
            await Task.WhenAll(
                _serviceStatusCard.RefreshData(),
                _recentActiveUsersCard.RefreshData(),
                _activeUsersCard.RefreshData(),
                _registrationStatisticsCard.RefreshData(),
                _emailStatisticsCard.RefreshData(),
                _emailClaimsCard.RefreshData()
            );
        }
    }
}
