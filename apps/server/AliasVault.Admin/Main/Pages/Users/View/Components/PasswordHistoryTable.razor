@using AliasVault.Shared.Models.Enums
@using AliasVault.RazorComponents.Tables

@if (PasswordHistoryList.Count == 0)
{
    <p class="text-sm text-gray-500 dark:text-gray-400">
        No previous records found.
    </p>
}
else
{
    <SortableTable Columns="@_passwordHistoryTableColumns" SortColumn="@SortColumn" SortDirection="@SortDirection" OnSortChanged="HandleSortChanged">
        @foreach (var entry in SortedPasswordHistoryList)
        {
            <SortableTableRow>
                <SortableTableColumn IsPrimary="true">@entry.ArchivedAt.ToString("yyyy-MM-dd HH:mm")</SortableTableColumn>
                <SortableTableColumn>@UnlockMethodTypes.ToToken(entry.Type)</SortableTableColumn>
                <SortableTableColumn>@(entry.ArchivedByClient ?? "-")</SortableTableColumn>
                <SortableTableColumn>@entry.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</SortableTableColumn>
                <SortableTableColumn>@DescribeExpiry(entry)</SortableTableColumn>
                <SortableTableColumn>
                    <Button Color="danger" OnClick="() => RevertAsync(entry)">Revert password</Button>
                </SortableTableColumn>
            </SortableTableRow>
        }
    </SortableTable>
}

@code {
    /// <summary>
    /// Gets or sets the archived unlock keys still within the retention window.
    /// </summary>
    [Parameter]
    public List<UserUnlockKeysHistory> PasswordHistoryList { get; set; } = [];

    /// <summary>
    /// Gets or sets the retention window in days that produced this list, used to show when each row expires.
    /// </summary>
    [Parameter]
    public int RetentionDays { get; set; }

    /// <summary>
    /// Gets or sets the event callback to revert the user's password to an archived credential.
    /// </summary>
    [Parameter]
    public EventCallback<UserUnlockKeysHistory> OnRevert { get; set; }

    private string SortColumn { get; set; } = "ArchivedAt";
    private SortDirection SortDirection { get; set; } = SortDirection.Descending;

    private readonly List<TableColumn> _passwordHistoryTableColumns = [
        new TableColumn { Title = "Replaced at", PropertyName = "ArchivedAt" },
        new TableColumn { Title = "Method", PropertyName = "Type" },
        new TableColumn { Title = "Changed by", PropertyName = "ArchivedByClient" },
        new TableColumn { Title = "In use since", PropertyName = "UpdatedAt" },
        new TableColumn { Title = "Expires", Sortable = false },
        new TableColumn { Title = "Actions", Sortable = false },
    ];

    private IEnumerable<UserUnlockKeysHistory> SortedPasswordHistoryList => SortList(PasswordHistoryList, SortColumn, SortDirection);

    private void HandleSortChanged((string column, SortDirection direction) sort)
    {
        SortColumn = sort.column;
        SortDirection = sort.direction;
        StateHasChanged();
    }

    private static IEnumerable<UserUnlockKeysHistory> SortList(List<UserUnlockKeysHistory> entries, string sortColumn, SortDirection sortDirection)
    {
        return sortColumn switch
        {
            "ArchivedAt" => SortableTable.SortListByProperty(entries, e => e.ArchivedAt, sortDirection),
            "Type" => SortableTable.SortListByProperty(entries, e => e.Type, sortDirection),
            "ArchivedByClient" => SortableTable.SortListByProperty(entries, e => e.ArchivedByClient, sortDirection),
            "UpdatedAt" => SortableTable.SortListByProperty(entries, e => e.UpdatedAt, sortDirection),
            _ => entries
        };
    }

    /// <summary>
    /// Describes how much of the retention window is left for an archived credential.
    /// </summary>
    private string DescribeExpiry(UserUnlockKeysHistory entry)
    {
        var expiresAt = entry.ArchivedAt.AddDays(UnlockKeyHistoryPolicy.EffectiveRetentionDays(RetentionDays));
        var remaining = expiresAt - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "expired";
        }

        return remaining.TotalDays >= 1 ? $"in {(int)remaining.TotalDays}d {remaining.Hours}h" : $"in {(int)remaining.TotalHours}h";
    }

    private async Task RevertAsync(UserUnlockKeysHistory entry)
    {
        if (await ConfirmModalService.ShowConfirmation(
            title: "Confirm Password Revert",
            message: $@"Are you sure you want to revert this user's master password to the one they used before {entry.ArchivedAt:yyyy-MM-dd HH:mm} UTC?

Important notes:
• The user will need to log in with their OLD master password again.
• The vault is not rolled back: no vault data is lost or changed.
• All active sessions will be revoked and the user will need to login again on all devices.

Do you want to proceed with the revert?"))
        {
            await OnRevert.InvokeAsync(entry);
        }
    }
}
