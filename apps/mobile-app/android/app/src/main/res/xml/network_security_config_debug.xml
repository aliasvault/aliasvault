<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (selected in build.gradle): same as network_security_config.xml plus http:// to a local dev API. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system"/>
      <certificates src="user"/>
    </trust-anchors>
  </base-config>
</network-security-config>
