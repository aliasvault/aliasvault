    "@types/sql.js": "^1.4.9",
    "@types/yup": "^0.29.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "react-dom": "19.3.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    },
    "glob": "^14.0.3",
