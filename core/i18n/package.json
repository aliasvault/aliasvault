{
    "name": "@aliasvault/i18n",
    "version": "0.31.0",
    "description": "Translations shared by the AliasVault web app, browser extension and mobile app.",
    "type": "module",
    "private": true,
    "license": "AGPL-3.0",
    "exports": {
        ".": "./src/index.ts",
        "./all": "./src/all.ts",
        "./languages": "./src/languages.ts",
        "./locales/*": "./locales/*"
    },
    "scripts": {
        "compile": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "test": "vitest run",
        "export:native": "node scripts/export-native.mjs",
        "export:native:check": "node scripts/export-native.mjs --check",
        "hints:push": "node scripts/sync-hints.mjs",
        "hints:push:dry-run": "node scripts/sync-hints.mjs --dry-run"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsdoc": "^50.6.3",
        "globals": "^16.5.0",
        "typescript": "^5.6.3",
        "vitest": "^5.0.1"
    }
}
